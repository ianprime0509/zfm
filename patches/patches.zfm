@electric-piano 0 1, 2 3.
  sine 0.1 11 0.5 0.00001 0 0 0 0.00001
  sine 0.3 12 0 0.00001 0.5 0 0 0.00001
  sine 0.1 1 0 0.00001 2 0.2 0 2
  sine 1 1 0 0.00001 4 0 0 1

@strings 0 1, 2 3.
  sine 0.1 3 0.2 0.1 0 0 0 0.2
  sine 0.9 1 0 0.1 0 0 0 0.2
  sine 0.2 5 0 0.1 4 0 0 0.4
  sine 1 1 0 0.1 0 0 0 0.2

@harp 0 1 2 3.
  triangle 0.1 4 0.2 0.00001 4 0 0 4
  triangle 0.1 1 0 0.00001 4 0 0 4
  triangle 0.1 1 0 0.00001 4 0 0 4
  sine 1 1 0 0.00001 4 0 0 4

@deep-wah-bass 0 1 2 3.
  sine 0.2 1 0 0.02 0.02 0 0 0.2
  sine 1.5 0.25 0 0.2 0 0 0 0.2
  sine 0.2 0.25 0 0.00001 0 0 0 0.2
  sine 1 1 0 0.00001 0 0 0 0.2

@oud 0 1, 1 2, 2 3.
  square 0.5 8 0 0.5 0.04 0.01 0.7 2 0.7
  square 0.5 0.5 0 0.5 0.02 0.1 0.6 2 1
  sine 0.3 2 0 0.04 3 0 0 1
  sine 1 1 0 0.02 0.1 0.8 1 1

@synth-bell 0 1.
  sine 0.2 5 0 0.00001 0 0 0 0
  sine 1 1 0 0.00001 2 0 0 2

@synth-bass 0 1.
  sine 0.8 0.5 0 0.00001 0.05 0 0 0.00001
  sine 1 1 0.3 0.00001 1 0 0 0.00001

@warm-synth-bass 0 1.
  sine 0.2 0.5 0 0.00001 0 0 0 0
  sine 1 1 0 0.00001 10 0 0 10

@distant-radio 0 1, 2 3.
  sine 0.5 3 0 0.00001 0 0 0 0
  sine 1 1 0 0.00001 0 0 0 0.0001
  sine 0.3 4 0 0.00001 0 0 0 0
  sine 1 1 0 0.00001 0 0 0 0.0001

@soft-pluck-bass 0 1.
  sine 1.5 1 1.5 0.00001 0.05 0 0 0.00001
  sine 1 1 0.2 0.00001 0.5 0 0 0.00001

@deep-bass .
  sine 2 0.25 0.2 0.00001 2 0 0 0.00001
  sine 1 0.5 0.2 0.00001 2 0 0 0.00001

@steel-drum 0 1, 2 3.
  sine 0.2 3 0 0.00001 0 0 0 1
  sine 1 1 0 0.00001 1 0 0 1
  sine 0.4 5 0 0.2 0.5 0.2 0 1
  sine 1 1 0 0.00001 3 0 0 1

@edm-bass 0 1.
  sine 0.8 0.25 0 0.00001 1 0 0 0.00001
  sine 1 0.25 0.3 0.00001 2 0 0 0.00001

; Note: increasing ML of slot 0 makes the sound more metallic
@edm-bass-2 0 1.
  sine 0.8 0.5 0 0.00001 1 0 0 0.00001
  sine 1 0.25 0.2 0.00001 2 0 0 0.00001

; LFO preset: MT0,freq MS0,440,0 MW0,exp,-100 MO0,key_on MA0,on
@heavy-edm-bass 0 1.
  sine 0.8 0.5 0 0.00001 3 0 0 1
  sine 1 0.25 0.2 0.00001 20 0 0 1

; LFO preset: MT0,freq MS0,220,-440 MW0,exp,-20 MO0,key_on MA0,on
@edm-kick .
  sine 1 1 0.2 0.00001 10 0 0 0.00001

@bass-drum .
  sine 1 0.25 0.6 0.02 0.5 0 0 0.1
  noise 0.5 0.1 0 0.5 0.08 2 0 0 1
  sine 1 0.25 0 0.00001 1 0 0 0.00001

@snare-drum .
  sine 1 50 3 0.00001 1 0 0 0.00001
  sine 0.3 1 0 0.00001 0.1 0 0 0.1
  noise 0.1 1 0 0.5 0.08 2 0 0 1

@rim .
  sine 1 2 3 0.00001 0.1 0 0 0.1
  noise 0.2 1 0 1 0.00001 0.2 0 0 0.2

@brass 0 1.
  sine 0.2 1 0.3 0.04 0 0 0 0.00001
  sine 1 1 0.2 0.04 0 0 0 0.00001

@breathy-flute 0 1.
  sine 0.2 2 0 0.04 0 0 0 0.00001
  sine 1 2 0 0.04 0.1 0.8 0 0.00001
  noise 0.3 4 0 30 0.04 0.5 0 0 0.00001

; Note: MA0,off results in a wider (more inconsistent) variety of sounds
; LFO preset: MT0,freq MS0,100,-100 MW0,exp,-20 MO0,key_on MA0,on
@ray-gun 0 1.
  sine 5 30 0 0.00001 0 0 0 1
  sine 1 1 0 0.00001 1 0 0 1
