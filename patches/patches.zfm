@electric-piano 0 1, 2 3.
  sine 0.7 11 3 1 0 0 0 1
  sine 0.3 12 0 1 0.0001 0 0 1
  sine 0.7 1 0 1 0.000025 0.2 0 0.00001
  sine 1 1 0 1 0.00001 0 0 0.00005

@strings 0 1, 2 3.
  sine 0.9 3 1 0.0002 0 0 0 0.0001
  sine 0.9 1 0 0.0002 0 0 0 0.0001
  sine 0.8 5 0 0.0002 0.00001 0 0 0.0001
  sine 1 1 0 0.0002 0 0 0 0.0001

@deep-wah-bass 0 1 2 3.
  sine 1 1 0 0.001 0.001 0 0 0.0001
  sine 10 0.25 0 0.0001 0 0 0 0.0001
  sine 1 0.25 0 1 0 0 0 0.0001
  sine 1 1 0 1 0 0 0 0.0001

@desert-echoes 0 1 2 3.
  sine 1 1 0 0.001 0.0001 0 0 0.00005
  sine 10 0.5 0 0.0001 0 0 0 0.00005
  sine 2 0.5 0 1 0 0 0 0.00005
  sine 1 1 0 1 0.00001 0 0 0.00005

@oud 0 1, 1 2, 2 3.
  square 3 8 0 0.5 0.0005 0.001 0.7 0.00001 0.00003
  square 3 0.5 0 0.5 0.001 0.0001 0.6 0.00001 0.00003
  sine 2 2 0 0.0005 0.00001 0 0 0.00003
  sine 1 1 0 0.001 0.0001 0.8 0.000025 0.00005

@synth-bell 0 1.
  sine 1 5 0 1 0 0 0 0
  sine 1 1 0 1 0.00001 0 0 0.00001

@synth-bass 0 1.
  sine 5 0.5 0 1 0.001 0 0 1
  sine 1 1 2 1 0.0001 0 0 1

@warm-synth-bass 0 1.
  sine 1 0.5 0 1 0 0 0 0
  sine 1 1 0 1 0.00001 0 0 0.00001

@distant-radio 0 1, 2 3.
  sine 3 3 0 1 0 0 0 0
  sine 1 1 0 1 0 0 0 0.0001
  sine 2 4 0 1 0 0 0 0
  sine 1 1 0 1 0 0 0 0.0001

@soft-pluck-bass 0 1.
  sine 10 1 10 1 0.001 0 0 1
  sine 1 1 1 1 0.0001 0 0 1

@deep-bass .
  sine 2 0.125 1 1 0.00005 0 0 1
  sine 1 0.25 1 1 0.00005 0 0 1

@acoustic-guitar 0 1 2 3.
  sine 3 5 0 0.0005 0.0005 0.7 0.00001 0.00003
  sine 2 4 0 0.001 0.0001 0.6 0.00001 0.00003
  sine 2 1 0 0.0005 0.00001 0 0 0.00003
  sine 1 1 0 0.001 0.00001 0.6 0.00005 0.00003

@distorted-guitar 1 2 3, 0 3.
  sine 20 0.5 5 1 0.0005 0 0 0.00005
  sine 5 1 0 1 0.00001 0 0 0.00005
  sine 10 0.5 0 1 0.00001 0.4 0 0.00005
  sine 1 1 0 1 0.000005 0 0 0.00005

@steel-drum 0 1, 2 3.
  sine 1 3 0 1 0 0 0 0.00005
  sine 1 1 0 1 0.00002 0 0 0.00005
  sine 2.5 5 0 0.0001 0.00005 0.2 0 0.00005
  sine 1 1 0 1 0.00002 0 0 0.00005

@edm-bass 0 1.
  sine 5 0.25 0 1 0.0001 0 0 1
  sine 1 0.25 2 1 0.00002 0 0 1

@edm-bass-2 0 1.
  ; Note: increasing ML of slot 0 makes the sound more metallic
  sine 5 0.5 0 1 0.0001 0 0 1
  sine 1 0.25 1 1 0.00005 0 0 1

; LFO preset: MT0,freq MS0,440,0 MW0,exp,-100 MO0,key_on MA0,on
@heavy-edm-bass 0 1.
  sine 5 0.5 0 1 0.00001 0 0 0.0001
  sine 1 0.25 1 1 0.0000025 0 0 0.0001

; LFO preset: MT0,freq MS0,220,-440 MW0,exp,-20 MO0,key_on MA0,on
@edm-kick .
  sine 1 1 1 1 0.0001 0 0 1

@bass-drum .
  sine 0 50 20 1 0.0001 0 0 1
  sine 1 0.5 4 0.001 0.001 0 0 0.001
  noise 0.5 0.1 0 0.5 0.00025 0.0001 0 0 0.00005
  sine 1 0.25 0 1 0.0001 0 0 1

@snare-drum .
  sine 1 50 20 1 0.0001 0 0 1
  sine 1 1 50 1 0.001 0 0 0.001
  noise 0.1 1 0 0.5 0.00025 0.00007 0 0 0.00005

@rim .
  sine 1 2 20 1 0.001 0 0 0.001
  noise 0.2 1 0 1 1 0.0005 0 0 0.0005

@brass 0 1.
  sine 1 1 2 0.0005 0 0 0 1
  sine 1 1 1 0.0005 0 0 0 1

@breathy-flute 0 1.
  sine 1 2 0 0.0005 0 0 0 1
  sine 1 2 0 0.0005 0.0001 0.8 0 1
  noise 0.3 4 0 30 0.0005 0.0002 0 0 1

; LFO preset: MT0,freq MS0,100,-100 MW0,exp,-20 MO0,key_on MA0,on
@ray-gun 0 1.
  ; Note: MA0,off results in a wider (more inconsistent) variety of sounds
  sine 30 30 0 1 0 0 0 0.0001
  sine 1 1 0 1 0.00005 0 0 0.0001
