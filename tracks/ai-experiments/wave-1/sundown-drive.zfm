; Sundown Drive - an original city pop track for ZFM
#title Sundown Drive
#composer Kimi K3
; Note: it originally called itself "Claude" lmao
#tempo 126

; ---------------- patches (from patches/patches.zfm) ----------------

@electric-piano 0 1, 2 3.
  sine 0.1 11 0.5 0.00001 0 0 0 0.00001
  sine 0.3 12 0 0.00001 0.5 0 0 0.00001
  sine 0.1 1 0 0.00001 2 0.2 0 2
  sine 1 1 0 0.00001 4 0 0 1

@strings 0 1, 2 3.
  sine 0.1 3 0.2 0.1 0 0 0 0.2
  sine 0.9 1 0 0.1 0 0 0 0.2
  sine 0.2 5 0 0.1 4 0 0 0.4
  sine 1 1 0 0.1 0 0 0 0.2

@synth-bass 0 1.
  sine 0.8 0.5 0 0.00001 0.05 0 0 0.00001
  sine 1 1 0.3 0.00001 1 0 0 0.00001

@brass 0 1.
  sine 0.2 1 0.3 0.04 0 0 0 0.00001
  sine 1 1 0.2 0.04 0 0 0 0.00001

@breathy-flute 0 1.
  sine 0.2 2 0 0.04 0 0 0 0.00001
  sine 1 2 0 0.04 0.1 0.8 0 0.00001
  noise 0.3 4 0 30 0.04 0.5 0 0 0.00001

@bass-drum .
  sine 1 0.25 0.6 0.02 0.5 0 0 0.1
  noise 0.5 0.1 0 0.5 0.08 2 0 0 1
  sine 1 0.25 0 0.00001 1 0 0 0.00001

@snare-drum .
  sine 1 50 3 0.00001 1 0 0 0.00001
  sine 0.3 1 0 0.00001 0.1 0 0 0.1
  noise 0.1 1 0 0.5 0.08 2 0 0 1

@rim .
  sine 1 2 3 0.00001 0.1 0 0 0.1
  noise 0.2 1 0 1 0.00001 0.2 0 0 0.2

; ---------------- setup ----------------

; Progression (8 bars, repeated 3x per loop):
;   | Fmaj7 | Em7 | Dm7 | Cmaj7 | Bbmaj7 | Am7 | Gm7 | C7 |
;
; A: electric piano comping   B: bass
; C: flute melody             D: strings pad
; E: brass answers            R: kick  S: snare  T: hats

A @electric-piano o4 p-0.4 v1.2 L
B @synth-bass o2 l4 v1.3 L
C @breathy-flute o4 p-0.2 v1.3 MT0,freq MS0,4,0 MW0,sine,5 MO0,key_on MA0,on *0 L
D @strings o4 l1 p0.4 v0.7 MT0,freq MS0,5,0 MW0,sine,5 MO0,key_on MA0,on *0 L
E @brass o4 l4 p0.5 v1.1 L
R @bass-drum o3 l4 v2 L
S @snare-drum o4 l4 v1.5 L
T @rim o4 l8 p0.3 v0.8 L

; ---------------- section 1: groove only ----------------

A [r8a8r8a4>c4<r8 r8g8r8g4b4r8 r8f8r8f4a4r8 r8e8r8e4g4r8
   r8d8r8d4f4r8 r8c8r8c4e4r8 r8<b-8r8b-4>d4r8 r8g8r8g4b-4r8]3
B [f4f4>c4c4< e4e4>b4b4< d4d4>a4a4< c4c4>g4g4<
   <b-4b-4>f4f4 a4a4>e4e4< g4g4>d4d4< c4c4>g8c8c4<]3
C [r1]8
D [f1 e1 d1 e1
   d1 c1 b-1 e1]3
E [r1]16
R [[c4r4c4r4]7 c4r4c4c8c8]3
S [[r4c4r4c4]7 r4c4c8c8c4]3
T [[[c]8]8]3

; ---------------- section 2: melody A ----------------

C a4>c8<a8g4e8g8 g4e8g8b4g8a8 a4f8a8>d4<a8b8 >c2<g4e8d8
C d4f8d8c4a8c8 c4a8c8e4c8d8 d4b-8d8g4d8e8 e4g8e8{dc}4c4

; ---------------- section 3: melody B + brass answers ----------------

C >c4.<a8g4a8g8 e2g8a8b8g8 f4a4>d4<a8g8 e2g4e8d8
C d4.c8a4f4 e2>c4<a8g8 d2b-8a8g8f8 e2.r4
E [r1]3
E r2g4b4 r2f4a4 r2e4g4 r2d4f4 r2e4g4
