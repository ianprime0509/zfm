; Neon Horizon - a synthwave track for ZFM
#title Neon Horizon
#composer Deepseek v4 Flash (0731)
#tempo 108

; ---------------- patches (from patches/patches.zfm) ----------------

@deep-wah-bass 0 1 2 3.
  sine 0.2 1 0 0.02 0.02 0 0 0.2
  sine 1.5 0.25 0 0.2 0 0 0 0.2
  sine 0.2 0.25 0 0.00001 0 0 0 0.2
  sine 1 1 0 0.00001 0 0 0 0.2

@brass 0 1.
  sine 0.2 1 0.3 0.04 0 0 0 0.00001
  sine 1 1 0.2 0.04 0 0 0 0.00001

@electric-piano 0 1, 2 3.
  sine 0.1 11 0.5 0.00001 0 0 0 0.00001
  sine 0.3 12 0 0.00001 0.5 0 0 0.00001
  sine 0.1 1 0 0.00001 2 0.2 0 2
  sine 1 1 0 0.00001 4 0 0 1

@strings 0 1, 2 3.
  sine 0.1 3 0.2 0.1 0 0 0 0.2
  sine 0.9 1 0 0.1 0 0 0 0.2
  sine 0.1 5 0 0.1 4 0 0 0.4
  sine 1 1 0 0.1 0 0 0 0.2

; LFO preset: MT0,freq MS0,220,-440 MW0,exp,-20 MO0,key_on MA0,on
@edm-kick .
  sine 1 1 0.2 0.00001 10 0 0 0.00001

@snare-drum .
  sine 1 50 3 0.00001 1 0 0 0.00001
  sine 0.3 1 0 0.00001 0.1 0 0 0.1
  noise 0.1 1 0 0.5 0.08 2 0 0 1

@rim .
  sine 1 2 3 0.00001 0.1 0 0 0.1
  noise 0.2 1 0 1 0.00001 0.2 0 0 0.2

; ---------------- macros ----------------

; bass bars (o2, root + fifth pulse)
!bb-am a8a8e8e8a8a8e8e8
!bb-f  f8f8c8c8f8f8c8c8
!bb-c  c8c8g8g8c8c8g8g8
!bb-g  g8g8d8d8g8g8d8d8

; arpeggio bars (o4, chord tones, wave shape)
!ar-am a8c8e8a8e8c8a8c8
!ar-f  f8a8c8f8c8a8f8a8
!ar-c  c8e8g8c8g8e8c8e8
!ar-g  g8b8d8g8d8b8g8b8

; pad bars (o3, whole note chord roots)
!p-am a1
!p-f  f1
!p-c  c1
!p-g  g1

; drums (one bar each)
!kick  c4c4c4c4
!snare r4c4r4c4
!hats  r8c8r8c8r8c8r8c8

; lead melody bars (o4, A minor)
!mel-1 e8r8a8r8c8e8d8c8
!mel-2 a8r8c8d8e8d8c8r8
!mel-3 c8r8e8r8g8e8d8c8
!mel-4 d8r8b8r8d8c8b8a8
!mel-5 e8r8a8r8c8e8d8c8
!mel-6 a8r8c8d8e8d8c8r8
!mel-7 e8e8g8g8c8e8d8c8
!mel-8 d8d8b8d8c8b8a8r8

; ---------------- parts setup ----------------

A @brass MT0,freq MS0,6,0 MW0,sine,5.5 MO0,key_on MA0,on *0 v1 p0.15
B @deep-wah-bass v1.1 p-0.1
C @electric-piano v0.8 p0.45
D @strings v0.55 p0
K @edm-kick MT0,freq MS0,220,-440 MW0,exp,-20 MO0,key_on MA0,on *0 v1.6 p-0.2
S @snare-drum v1.5 p0.3
H @rim v0.9 p-0.5

; ---------------- intro (bars 1-8): lead rests ----------------

A o4 l8 r1r1r1r1r1r1r1r1
B o2 l8 !bb-am !bb-f !bb-c !bb-g !bb-am !bb-f !bb-c !bb-g
C o4 l8 !ar-am !ar-f !ar-c !ar-g !ar-am !ar-f !ar-c !ar-g
D o3 l1 !p-am !p-f !p-c !p-g !p-am !p-f !p-c !p-g
K o4 !kick !kick !kick !kick !kick !kick !kick !kick
S o3 !snare !snare !snare !snare !snare !snare !snare !snare
H o4 !hats !hats !hats !hats !hats !hats !hats !hats

ABCDKSH L

; ---------------- lead section (bars 9-16) ----------------

A !mel-1 !mel-2 !mel-3 !mel-4 !mel-5 !mel-6 !mel-7 !mel-8
B !bb-am !bb-f !bb-c !bb-g !bb-am !bb-f !bb-c !bb-g
C !ar-am !ar-f !ar-c !ar-g !ar-am !ar-f !ar-c !ar-g
D !p-am !p-f !p-c !p-g !p-am !p-f !p-c !p-g
K !kick !kick !kick !kick !kick !kick !kick !kick
S !snare !snare !snare !snare !snare !snare !snare !snare
H !hats !hats !hats !hats !hats !hats !hats !hats
