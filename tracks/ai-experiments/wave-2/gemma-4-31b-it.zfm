#title Bullet Hell Stage
#composer gemma-4-31b-it
#tempo 175

@edm-bass 0 1.
  sin 0.8 0.25 0 0.00001 1 0 0 0.00001
  sin 1 0.25 0.3 0.00001 2 0 0 0.00001

@bass-drum .
  sin 1 0.25 0.6 0.02 0.5 0 0 0.1
  noi 0.5 0.1 0 0.5 0.08 2 0 0 1
  sin 1 0.25 0 0.00001 1 0 0 0.00001

@snare-drum .
  sin 1 50 3 0.00001 1 0 0 0.00001
  sin 0.3 1 0 0.00001 0.1 0 0 0.1
  noi 0.1 1 0 0.5 0.08 2 0 0 1

@synth-bell 0 1.
  sin 0.2 5 0 0.00001 0 0 0 0
  sin 1 1 0 0.00001 2 0 0 2

@brass 0 1.
  sin 0.2 1 0.3 0.04 0 0 0 0.00001
  sin 1 1 0.2 0.04 0 0 0 0.00001

A @edm-bass o2 [c8 c8 c8 c8 e-8 e-8 e-8 e-8 f8 f8 f8 f8 g8 g8 g8 g8]4
B @bass-drum o2 [c4 c4 c4 c4]8
C @snare-drum o2 [r4 c4 r4 c4]8
D @synth-bell o4 [c8 e-8 f8 g8 o3 g8 e-8 c8 g8 b-8 g8 f8 e-8 f8 g8 b-8 o4 c8]4
E @brass o4 [r4 c4 r4 e-4 r4 f4 r4 g4]4
