; ============================================================
; Parts
; Structure: intro (4) | A (8) | B (8) | A' (8) | outro (5)
; Chords:    A:  Am Am F G Am Am F E
;            B:  F G Am Am F G Am E
; ============================================================

; --- Lead ---
A @MEGASyn v0.85 p-0.15
  [r1]4
  ; section A
  !mA1 !mA2 !mA3 !mA4 !mA1 !mA2 !mA3 !mA8
  ; section B: melody takes a breather
  [r1]8
  ; section A'
  !mA1 !mA2 !mA3 !mA4 !mA1 !mA2 !mA3 !mA8
  ; outro: reprise into the final hit
  !mA1 !mA3 !mA4 !mO4 o5 >a1<

; --- Harmony (enters for A') ---
B @KiraBrs v0.5 p0.15
  [r1]20
  !mH1 !mH2 !mH3 !mH4 !mH1 !mH2 !mH3 !mH8
  [r1]4
  o5 a1

