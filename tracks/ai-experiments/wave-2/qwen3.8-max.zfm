  !arAm !arAm !arAm !arAm !arF !arF !arE !arE
  ; outro: Am F G E + final hit
  !arAm !arAm !arF !arF !arG !arG !arE !arE
  !arAm !arAm

; --- Bass ---
D @edm-bass-2 o2 v0.9 p0
  r1 r1 !bF !bG
  ; A
  !bA !bA !bF !bG !bA !bA !bF !bE
  ; B
