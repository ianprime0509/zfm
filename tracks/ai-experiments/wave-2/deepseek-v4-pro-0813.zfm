; =============================================================
; Neon Skies - Bullet Hell Stage Theme
; An upbeat, energetic FM synth track for ZFM.
; Progression (E minor): i  VI  III  VII  i  VI  iv  V
; =============================================================

#title Neon Skies
#composer deepseek-v4-pro-0813
#tempo 160

; ---- Patches ----

; Bright, sustained lead
@brass 0 1.
  sine 0.2 1 0.3 0.04 0 0 0 0.00001
  sine 1 1 0.2 0.04 0 0 0 0.00001

; Driving FM bass
@synth-bass 0 1.
  sine 0.8 0.5 0 0.00001 0.05 0 0 0.00001
  sine 1 1 0.3 0.00001 1 0 0 0.00001

; Sustained pad
@strings 0 1, 2 3.
  sine 0.1 3 0.2 0.1 0 0 0 0.2
  sine 0.9 1 0 0.1 0 0 0 0.2
  sine 0.2 5 0 0.1 4 0 0 0.4
  sine 1 1 0 0.1 0 0 0 0.2

; Bright plucked arpeggio voice
@harp 0 1 2 3.
  triangle 0.1 4 0.2 0.00001 4 0 0 4
  triangle 0.1 1 0 0.00001 4 0 0 4
  triangle 0.1 1 0 0.00001 4 0 0 4
  sine 1 1 0 0.00001 4 0 0 4

; Kick drum
@bass-drum .
  sine 1 0.25 0.6 0.02 0.5 0 0 0.1
  noise 0.5 0.1 0 0.5 0.08 2 0 0 1
  sine 1 0.25 0 0.00001 1 0 0 0.00001

; Snare drum
@snare-drum .
  sine 1 50 3 0.00001 1 0 0 0.00001
  sine 0.3 1 0 0.00001 0.1 0 0 0.1
  noise 0.1 1 0 0.5 0.08 2 0 0 1

; Closed hi-hat (noise burst)
@hi-hat .
  noise 0.4 1 0 0.1 0.0001 0.05 0 0 0.06

; ---- Macros: one bar of 16th-note arpeggio (each starts/ends in octave 4) ----

!arp-em e16g16b16g16e16g16b16g16e16g16b16g16e16g16b16g16
!arp-c  c16e16g16e16c16e16g16e16c16e16g16e16c16e16g16e16
!arp-g  g16b16>d16<b16g16b16>d16<b16g16b16>d16<b16g16b16>d16<b16
!arp-d  d16f+16a16f+16d16f+16a16f+16d16f+16a16f+16d16f+16a16f+16
!arp-am a16>c16e16c16<a16>c16e16c16<a16>c16e16c16<a16>c16e16c16
!arp-b  b16d+16f+16d+16b16d+16f+16d+16b16d+16f+16d+16b16d+16f+16d+16

; ---- Parts ----
; A: lead melody (brass, with a touch of vibrato)
A @brass v0.8 p0 o4
  MT0,freq MS0,3,0 MW0,sine,5.5 MO0,key_on MA0,on *0,on
  r1 r1 r1 r1
  L
  e4 g8 a8 b8 a8 g8 e8
  c4 e8 g8 >c8 <g8 e8 c8
  d4 e8 g8 b8 g8 e8 d8
  f+4 a8 >d8 <e8 d8 a8 f+8
  e4 g8 a8 b8 a8 g8 e8
  c4 e8 g8 >c8 <g8 e8 c8
  a4 >c8 e8 g8 e8 c8 <a8
  b4 d+8 f+8 a8 f+8 d+8 b8

; B: bass (octave-bouncing eighth notes)
B @synth-bass v0.7 p0 o3
  o3 e8>e8<e8>e8<e8>e8<e8>e8
  o3 e8>e8<e8>e8<e8>e8<e8>e8
  o3 c8>c8<c8>c8<c8>c8<c8>c8
  o3 d8>d8<d8>d8<d8>d8<d8>d8
  L
  o3 e8>e8<e8>e8<e8>e8<e8>e8
  o3 c8>c8<c8>c8<c8>c8<c8>c8
  o3 g8>g8<g8>g8<g8>g8<g8>g8
  o3 d8>d8<d8>d8<d8>d8<d8>d8
  o3 e8>e8<e8>e8<e8>e8<e8>e8
  o3 c8>c8<c8>c8<c8>c8<c8>c8
  o3 a8>a8<a8>a8<a8>a8<a8>a8
  o3 b8>b8<b8>b8<b8>b8<b8>b8

; C: pad (chord third)
C @strings v0.4 p0.3 o4
  g1 g1 e1 f+1
  L
  g1 e1 b1 f+1
  g1 e1 c1 d+1

; D: pad (chord root)
D @strings v0.4 p-0.3 o3
  e1 e1 c1 d1
  L
  e1 c1 g1 d1
  e1 c1 a1 b1

; E: 16th-note arpeggio
E @harp v0.5 p-0.4 o4
  !arp-em !arp-em !arp-c !arp-d
  L
  !arp-em !arp-c !arp-g !arp-d
  !arp-em !arp-c !arp-am !arp-b

; F: kick drum (four on the floor, with fills)
F @bass-drum v0.9 p0 o2
  c4 c4 c4 c4
  c4 c4 c4 c4
  c4 c4 c4 c4
  c4 c8 c8 c8 c8 c8 c8
  L
  c4 c4 c4 c4
  c4 c4 c4 c4
  c4 c4 c4 c4
  c4 c8 c8 c8 c8 c8 c8
  c4 c4 c4 c4
  c4 c4 c4 c4
  c4 c4 c4 c4
  c4 c8 c8 c8 c8 c8 c8

; G: snare drum (backbeat on 2 and 4, with fills)
G @snare-drum v0.7 p0 o4
  r4 c4 r4 c4
  r4 c4 r4 c4
  r4 c4 r4 c4
  r4 c4 c8 c8 c8 c8
  L
  r4 c4 r4 c4
  r4 c4 r4 c4
  r4 c4 r4 c4
  r4 c4 c8 c8 c8 c8
  r4 c4 r4 c4
  r4 c4 r4 c4
  r4 c4 r4 c4
  r4 c4 c8 c8 c8 c8

; H: hi-hat (offbeat eighth notes, straight eighths into the fills)
H @hi-hat v0.35 p0.3 o5
  r8c8r8c8r8c8r8c8
  r8c8r8c8r8c8r8c8
  r8c8r8c8r8c8r8c8
  r8c8r8c8r8c8r8c8
  L
  r8c8r8c8r8c8r8c8
  r8c8r8c8r8c8r8c8
  c8c8c8c8c8c8c8c8
  c8c8c8c8c8c8c8c8
  r8c8r8c8r8c8r8c8
  r8c8r8c8r8c8r8c8
  c8c8c8c8c8c8c8c8
  c8c8c8c8c8c8c8c8
