#title Crimson Stratosphere ~ Blazing Danmaku
#composer gemini-3.7-flash
#tempo 166

; ==============================================================================
; PATCH DEFINITIONS
; ==============================================================================

; --- Drums & Percussion ---

; Kick Drum (Punchy FM transient + low body thud)
@kick 0 1.
  sin 3.2 0.5 0 0.00001 0.018 0 0 0.00001
  sin 1.0 0.5 0.35 0.00001 0.12 0 0 0.00001

; Snare Drum (Snappy FM body + crisp noise burst)
@snare 0 1.
  sin 2.8 4 0.25 0.00001 0.035 0 0 0.00001
  sin 1.0 2 0.45 0.00001 0.09 0 0 0.00001
  noi 0.95 1 0 0.8 0.00001 0.13 0 0 0.03

; Closed Hi-Hat (Crisp, metallic tick)
@hh-cl .
  noi 0.65 8 0 30 0.00001 0.025 0 0 0.01
  sin 0.25 14 0.3 0.00001 0.015 0 0 0.01

; Open Hi-Hat (Sizzling splash)
@hh-op .
  noi 0.7 8 0 30 0.00001 0.18 0 0 0.06
  sin 0.25 14 0.3 0.00001 0.12 0 0 0.04

; Crash Cymbal (Epic shimmering wash)
@crash .
  noi 0.85 4 0 16 0.00001 0.95 0 0 0.45
  sin 0.35 7.2 1.0 0.00001 0.65 0 0 0.25

; FM Synth Tom (For fills and rolls)
@tom 0 1.
  sin 2.2 1 0.35 0.00001 0.03 0 0 0.00001
  sin 1.0 1 0.4 0.00001 0.16 0 0 0.00001

; --- Bass & Harmony ---

; Slap / Synth Bass (Tight, growling 16th punch)
@bass 0 1, 2 3.
  sin 2.2 1 0.45 0.00001 0.04 0 0 0.00001
  sin 1.0 0.5 0 0.00001 0.28 0.3 0.1 0.00001
  sin 1.0 3 0.15 0.00001 0.02 0 0 0.00001
  sin 0.7 0.5 0 0.00001 0.28 0.3 0.1 0.00001

; FM Poly Synth (Syncopated chord stabs)
@poly-stab 0 1, 2 3.
  sin 0.5 1 0.25 0.001 0.2 0.35 0.05 0.06
  sin 1.0 1 0 0.001 0.25 0.45 0.05 0.06
  sin 0.35 3 0 0.001 0.12 0.15 0 0.04
  sin 0.5 1 0 0.001 0.25 0.45 0.05 0.06

; FM Strings Pad (Lush harmonic bed)
@strings-pad 0 1, 2 3.
  sin 0.15 3 0.2 0.08 0 0 0 0.2
  sin 0.85 1 0 0.08 0 0 0 0.2
  sin 0.2 5 0 0.08 4 0 0 0.3
  sin 1.0 1 0 0.08 0 0 0 0.2

; --- Leads & Arpeggios ---

; FM Main Lead ("ZUNpet" / Soaring FM Brass Lead)
@fm-lead 0 1, 2 3.
  sin 0.9 1 0.35 0.004 0.08 0.7 0 0.04
  sin 1.0 1 0 0.004 0 0 0 0.04
  sin 0.45 2 0.15 0.008 0.12 0.55 0 0.04
  saw 0.35 1 0 0.004 0 0 0 0.04

; FM Counter Lead (High Flute / Whistle)
@flute-lead 0 1.
  sin 0.3 2 0 0.02 0.04 0.85 0 0.03
  sin 1.0 1 0 0.01 0 0 0 0.03
  noi 0.08 4 0 25 0.02 0.08 0 0 0.01

; FM Bell Arpeggio (Sparkling 16th chimes)
@bell-arp 0 1.
  sin 1.5 3.5 0.15 0.00001 0.07 0 0 0.03
  sin 1.0 1 0 0.00001 0.2 0 0 0.03

; Chiptune Square / Solo Lead
@chiptune-lead 0 1.
  squ 0.45 2 0.1 0.5 0.001 0.08 0.75 0 0.02
  saw 1.0 1 0 0.001 0 0 0 0.02


; ==============================================================================
; MACROS (Rhythm patterns, drum grooves, arpeggios)
; ==============================================================================

; --- Drum Macros (96 ticks each) ---
!k4 c4 c4 c4 c4
!k-sync c8. c16 c8 c8 c8. c16 c8 c8
!sn-std r4 c4 r4 c4
!sn-roll [c16]16
!sn-build r4 c4 r8 c8 [c16]4
!hh-drive [c8 c16 c16]4

; --- Bass Macros (96 ticks each, net octave = 0) ---
!b-dm d8 d16 d16 d8 > d8 < d8 d16 d16 d8 f8
!b-c c8 c16 c16 c8 > c8 < c8 c16 c16 c8 e8
!b-bb b-8 b-16 b-16 b-8 > b-8 < b-8 b-16 b-16 b-8 > d8 <
!b-a a8 a16 a16 a8 > a8 < a8 a16 a16 c+8 e8
!b-f f8 f16 f16 f8 > f8 < f8 f16 f16 f8 a8
!b-gm g8 g16 g16 g8 > g8 < g8 g16 g16 g8 b-8
!b-am a8 a16 a16 a8 > a8 < a8 a16 a16 a8 > c8 <

; --- Bell Arpeggio Macros (96 ticks each, net octave = 0) ---
!arp-dm d16 f a > d < a f d f  d f a > d < a f d f
!arp-c c16 e g > c < g e c e  c e g > c < g e c e
!arp-bb b-16 > d f b- < f d b- d  b-16 > d f b- < f d b- d
!arp-a a16 > c+ e a < e c+ a > c+ <  a16 > c+ e a < e c+ a > c+ <
!arp-f f16 a > c f < c a f a  f a > c f < c a f a
!arp-gm g16 b- > d g < d b- g b-  g b- > d g < d b- g b-
!arp-am a16 > c e a < e c a > c <  a16 > c e a < e c a > c <
!arp-asus a16 > d e a < e d a > d <  a16 > c+ e a < e c+ a > c+ <


