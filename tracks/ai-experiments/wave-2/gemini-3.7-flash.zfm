#title Crimson Zenith - Stage 1 (Aerial Fleet Assault)
#composer gemini-3.7-flash
#tempo 165

; ==============================================================================
; FM SYNTH PATCHES
; ==============================================================================

; 1. Main Shmup Lead (Bright Cutting FM Saw/Square Lead with Vibrato)
@shmup-lead 0 1, 2 3, 4.
  saw 0.45 2 0.15 0.001 0.1 0.7 0 0.05
  saw 1.0 1 0 0.001 0.1 0.85 0 0.05
  squ 0.3 3 0 0.5 0.001 0.15 0.6 0 0.05
  sin 0.7 1 0 0.001 0.1 0.85 0 0.05
  tri 0.35 0.5 0 0.001 0.1 0.85 0 0.05

; 2. Twin Lead (Warm FM Brass / Flute Lead for Dual Harmonies)
@twin-lead 0 1, 2 3.
  sin 0.5 3 0.2 0.002 0.1 0.7 0 0.06
  saw 1.0 1 0 0.002 0.1 0.85 0 0.06
  squ 0.35 2 0 0.4 0.002 0.12 0.7 0 0.06
  sin 0.8 1 0 0.002 0.1 0.85 0 0.06

; 3. Sparkle Bell (Crystalline High FM Bell)
@sparkle-bell 0 1, 2 3.
  sin 0.6 3.5 0.1 0.0001 0.5 0.15 0 0.2
  sin 1.0 1 0 0.0001 0.8 0.2 0 0.25
  sin 0.4 7 0 0.0001 0.3 0.05 0 0.15
  tri 0.7 2 0 0.0001 0.5 0.15 0 0.2

; 4. Arp Synth (Plucky 16th-note Ostinato Pluck)
@arp-synth 0 1, 2 3.
  squ 0.6 2 0 0.4 0.0001 0.08 0.1 0 0.03
  saw 1.0 1 0 0.0001 0.1 0.1 0 0.03
  sin 0.35 4 0 0.0001 0.06 0.05 0 0.02
  tri 0.5 1 0 0.0001 0.1 0.1 0 0.03

; 5. Brass Pad / Stabs (Warm FM Synth Brass)
@brass-pad 0 1, 2 3.
  saw 0.4 1 0.1 0.015 0.15 0.75 0 0.08
  saw 1.0 1 0 0.015 0.15 0.8 0 0.08
  saw 0.35 2 0 0.015 0.15 0.7 0 0.08
  sin 0.7 1 0 0.015 0.15 0.8 0 0.08

; 6. EPiano / Clav (Percussive Comping Keys)
@epiano 0 1, 2 3.
  sin 0.15 11 0.1 0.0001 0.05 0.3 0 0.12
  sin 0.4 1 0 0.0001 0.6 0.1 0 0.1
  sin 0.2 1 0 0.0001 0.8 0.2 0 0.12
  sin 1.0 1 0 0.0001 0.8 0.1 0 0.1

; 7. Driving FM Bass (Punchy, Relentless 16th-note FM Bass)
@drive-bass 0 1, 2 3.
  saw 0.8 1 0.3 0.0001 0.12 0.4 0 0.04
  sin 1.0 0.5 0 0.0001 0.25 0.5 0 0.04
  squ 0.5 2 0 0.5 0.0001 0.08 0.2 0 0.04
  saw 0.7 0.5 0 0.0001 0.2 0.4 0 0.04

; 8. Kick Drum (Punchy FM/Noise Kick)
@kick .
  sin 1.0 0.5 0.4 0.0001 0.08 0 0 0.02
  noi 0.25 0.5 0 6 0.0001 0.02 0 0 0.01

; 9. Snare Drum (Snappy FM/Noise Snare)
@snare .
  noi 0.85 1 0 2.5 0.0001 0.12 0 0 0.04
  sin 0.5 2 0.5 0.0001 0.08 0 0 0.03
  saw 0.3 3 0 0.0001 0.06 0 0 0.02

; 10. Closed Hi-Hat
@hat-cl .
  noi 0.8 1 0 0.15 0.0001 0.025 0 0 0.012

; 11. Open Hi-Hat
@hat-op .
  noi 0.85 1 0 0.25 0.0001 0.16 0 0 0.08

; 12. Crash Cymbal
@crash .
  noi 0.95 1 0 0.2 0.0001 0.9 0 0 0.6
  sin 0.2 11 0.4 0.0001 0.4 0 0 0.3

; 13. Synth Tom
@tom .
  sin 1.0 1 0.5 0.0001 0.15 0 0 0.04
  noi 0.2 1 0 4 0.0001 0.02 0 0 0.01


